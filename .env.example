# Copy of .env with explanations. Change the values in .env (not here) to run the tutorials on your own data.
# Relative paths are relative to the repository root; absolute paths are used as they are.

# folder with the scans, one file <id><CMB_SCAN_SUFFIX>.nii.gz per case (T2*-GRE)
CMB_INPUT_DIR=examples/phantoms/raw
# folder with the reference microbleed masks <id><CMB_LABEL_SUFFIX>.nii.gz (training and fine-tuning only)
CMB_LABEL_DIR=examples/phantoms/raw
# folder with brain masks <id><CMB_MASK_SUFFIX>.nii.gz (leave the masks out and the tutorials compute them)
CMB_MASK_DIR=examples/phantoms/raw
CMB_SCAN_SUFFIX=_T2starw
CMB_LABEL_SUFFIX=_cmb
CMB_MASK_SUFFIX=_brainmask
# one scan for tutorial_predict.py
CMB_SCAN=examples/phantoms/raw/syn-001_T2starw.nii.gz
# the model grid written by preprocess (0.5 x 0.5 x 1 mm, image + FRST + label per case)
CMB_GRID_DIR=runs/tutorial_grid
# where tutorial_train.py writes its model (<seed>/modell.pt + meta.json; cv/ for stage 2)
CMB_MODEL_DIR=runs/tutorial_model
# where tutorial_finetune.py writes the fine-tuned model
CMB_FINETUNED_DIR=runs/tutorial_finetuned
# where tutorial_predict.py writes mask, probability map and CSV
CMB_OUTPUT_DIR=runs/tutorial_output
# quick-run settings of the tutorials (patches per epoch, seeds of the members); remove for the paper's 800 / "42 1"
CMB_PATCHES=8
CMB_SEEDS=42
# optional, for the paper scripts (scripts/paper): load with   set -a; source .env; set +a
# CMB_ROOT=.                      results and dev/ (default: the repository)
# CMB_PRIVATE=private             work folder of your own cohorts (git-ignored)
# CMB_VALDO=data/valdo2021/Task2  VALDO 2021 Task 2
